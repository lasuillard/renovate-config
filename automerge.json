{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "description": "Automerge pins and digests",
      "matchUpdateTypes": [
        "pin",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Automerge trusted GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/*",
        "astral-sh/setup-uv",
        "aws-actions/*",
        "docker/*",
        "pnpm/action-setup"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Automerge trusted Python dependencies",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "boto3"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Automerge trusted Node.js dependencies",
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "svelte"
      ],
      "automerge": true
    }
  ]
}
