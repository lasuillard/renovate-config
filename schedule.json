{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "schedule:automergeOfficeHours"
  ],
  "schedule": [
    "* 9-17 * * 1"
  ],
  "lockFileMaintenance": {
    "enabled": false, // Disabled in favor of exact pinning and digesting
    "automerge": true,
    "extends": [
      "schedule:monthly"
    ]
  },
  "packageRules": [
    {
      "description": "Schedule pre-commit hook updates monthly",
      "matchManagers": [
        "pre-commit"
      ],
      "schedule": [
        "* 9-17 1 * *"
      ]
    },
    {
      "description": "Pin Docker digests",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true,
      "schedule": [
        "* 0-3 1 * *" // 1st of every month, early morning
      ]
    }
  ]
}
