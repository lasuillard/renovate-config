{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "schedule:weekly",
    "schedule:automergeOfficeHours"
  ],
  "lockFileMaintenance": {
    "enabled": false,
    "automerge": true,
    "extends": [
      "schedule:monthly"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true,
      "schedule": [
        "* 0-3 1 * *"
      ]
    }
  ]
}
