{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Group development dependencies (non-major)",
      "groupName": "Dev Dependencies (non-major)",
      "groupSlug": "dev-dependencies",
      "matchDepTypes": [
        "devDependencies",
        "dev-dependencies",
        "dev"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Group Python development dependencies (PEP 735 dependency-groups; uv)",
      "groupName": "Dev Dependencies (non-major)",
      "groupSlug": "dev-dependencies",
      "matchManagers": [
        "pep621"
      ],
      "matchJsonata": [
        "managerData.depGroup = 'dev'"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Group GitHub Actions updates",
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "matchManagers": [
        "github-actions"
      ]
    }
  ]
}
