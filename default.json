{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
  "extends": [
    "config:best-practices",
    "group:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "./schedule.json",
    "./groups.json",
    "./automerge.json"
  ],
  "ignorePresets": [
    "docker:pinDigests" // To override in package rules
  ],
  "timezone": "Asia/Seoul",
  "addLabels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "automergeSchedule": [
      "at any time"
    ]
  }
}
