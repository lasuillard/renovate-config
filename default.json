{
    "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
    "extends": [
        "config:best-practices",
        "group:recommended",
        "schedule:officeHours",
        "schedule:automergeOfficeHours",
        "helpers:pinGitHubActionDigestsToSemver"
    ],
    "timezone": "Asia/Seoul",
    "platformAutomerge":  false,
    "automergeStrategy": "squash",
    "minimumReleaseAge": "14 days",
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true,
        "schedule": [
            "* 0-3 1 * *" // Monthly
        ],
    },
    "packageRules": [
        {
            "groupName": "Dev Dependencies",
            "matchDepTypes": ["devDependencies"],
            "automerge": true
        },
        {
            "groupName": "GitHub Actions",
            "matchManagers": ["github-actions"]
        },
        {
            "matchUpdateTypes": ["patch", "pin", "digest", "pinDigest"],
            "automerge": true
        },
        {
            // Suppress tagless (only latest) image update noise
            "matchDatasources": ["docker"],
            "matchPackageNames": ["theasp/novnc"],
            "schedule": [
                "* * 1 */3 *" // Quarterly
            ]
        }
    ]
}
