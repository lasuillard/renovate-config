{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "./schedule.json",
    "./groups.json",
    "./automerge.json"
  ],
  "ignorePresets": [
    "docker:pinDigests" // To override in package rules
  ],
  "timezone": "Asia/Seoul",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "updateNotScheduled": true,
  "pre-commit": {
    "enabled": false
  },
  "addLabels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "automergeSchedule": [
      "at any time"
    ]
  },
  "npmrc": "allow-remote=all\n",
  "npmrcMerge": true,
  "ignoreScripts": true,
  "packageRules": [
    {
      "description": "Defer TypeScript 7 until dependent tooling supports it; remove this rule to resume upgrades",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ]
}
